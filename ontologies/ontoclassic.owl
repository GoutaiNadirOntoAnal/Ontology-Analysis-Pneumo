                  <swrl:argument1 rdf:resource="#d"/>
                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Somnolence diurne</swrl:argument2>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <swrl:AtomList>
                  <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#symptome"/>
                      <swrl:argument1 rdf:resource="#d"/>
                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ronflement</swrl:argument2>
                    </swrl:DatavaluedPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <swrl:AtomList>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#examcli"/>
                          <swrl:argument1 rdf:resource="#d"/>
                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apnées observées</swrl:argument2>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <swrl:AtomList>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="#polygraphie"/>
                              <swrl:argument1 rdf:resource="#d"/>
                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Index d'apnées-hypopnées &gt; 15</swrl:argument2>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </swrl:AtomList>
                      </rdf:rest>
                    </swrl:AtomList>
                  </rdf:rest>
                </swrl:AtomList>
              </rdf:rest>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
      </rdf:rest>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#aPathologie"/>
          <swrl:argument1 rdf:resource="#p"/>
          <swrl:argument2 rdf:resource="#SyndromeApneeSommeilInd"/>
        </swrl:IndividualPropertyAtom>
