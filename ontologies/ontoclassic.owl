  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tuberculose</rdfs:label>
  <rdfs:comment xml:lang="fr">Tuberculose : hémoptysie + sueurs nocturnes + AEG (fièvre, amaigrissement, asthénie)</rdfs:comment>
</swrl:Imp>

