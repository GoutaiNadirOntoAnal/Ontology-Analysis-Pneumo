  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Antécédents Personnels</rdfs:label>
  <synonyme xml:lang="fr">Antécédents médicaux personnels</synonyme>
  <synonyme xml:lang="fr">Passé médical</synonyme>
  <synonyme xml:lang="fr">Comorbidités</synonyme>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#atopie">
  <rdfs:domain rdf:resource="#Antecedents"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Atopie</rdfs:label>
  <synonyme xml:lang="fr">Terrain allergique</synonyme>
  <synonyme xml:lang="fr">Diathèse atopique</synonyme>
  <synonyme xml:lang="fr">Hypersensibilité IgE-médiée</synonyme>
  <synonyme xml:lang="fr">Allergie constitutionnelle</synonyme>
  <rdfs:comment xml:lang="fr">Valeurs : Eczéma | Eczema | Rhinite | Rhinite allergique | Conjonctivite | Urticaire | Dermatite atopique | Allergie alimentaire | Pollinose | Sensibilisation aux acariens | Allergie aux animaux | Sensibilisation aux moisissures</rdfs:comment>
</owl:DatatypeProperty>

