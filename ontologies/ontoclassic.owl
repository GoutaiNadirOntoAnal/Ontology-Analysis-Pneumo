<owl:DatatypeProperty rdf:about="#habitVie">
  <rdfs:domain rdf:resource="#FacteursEnvironnement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Habitudes de Vie</rdfs:label>
  <rdfs:comment xml:lang="fr">
      VALEURS NORMALISÉES (avec synonymes) :

      [TABAC]
      Tabac actif | Fumeur actif | Tabagisme actif | Fumeur | Tabagisme en cours | Consommation de tabac active
      Tabac sevré | Ex-fumeur | Tabagisme sevré | Ancien fumeur | Tabagisme passé
      Tabac passif | Tabagisme passif | Exposition passive à la fumée | Fumeur passif | Non-fumeur exposé
      Non-fumeur | Absence de tabagisme | Jamais fumé

      [ALCOOL]
      Alcool | Consommation d'alcool | Alcoolisme | Dépendance à l'alcool | Mésusage d'alcool

      [AUTRES]
      Sédentarité | Absence d'activité physique | Manque d'exercice
      Activité physique régulière | Sport régulier
      Obésité | Surpoids | Indice de masse corporelle élevé
    </rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#exposition">
  <rdfs:domain rdf:resource="#FacteursEnvironnement"/>
