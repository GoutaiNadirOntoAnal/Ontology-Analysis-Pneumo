<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/domo/ontologies/2023/4/D-ONTO"
         xmlns="http://www.semanticweb.org/domo/ontologies/2023/4/D-ONTO#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrl2="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#">

<owl:Ontology rdf:about="http://www.semanticweb.org/domo/ontologies/2023/4/D-ONTO">
  <rdfs:label xml:lang="fr">Ontologie de Pneumologie (D-ONTO)</rdfs:label>
  <rdfs:comment xml:lang="fr">Ontologie médicale pour la gestion des dossiers patients en pneumologie, incluant la classification des pathologies pulmonaires et les règles de diagnostic basées sur les symptômes cliniques.</rdfs:comment>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.0</owl:versionInfo>
</owl:Ontology>

