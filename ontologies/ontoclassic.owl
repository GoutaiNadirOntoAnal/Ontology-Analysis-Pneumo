  <rdfs:label xml:lang="fr">Antécédents Familiaux</rdfs:label>
  <synonyme xml:lang="fr">Hérédité pathologique</synonyme>
  <synonyme xml:lang="fr">Antécédents héréditaires</synonyme>
  <synonyme xml:lang="fr">Histoire familiale médicale</synonyme>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#antPers">
