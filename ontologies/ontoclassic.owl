  <synonyme xml:lang="fr">Test en laboratoire</synonyme>
  <synonyme xml:lang="fr">Analyse de laboratoire</synonyme>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#testGenetique">
  <rdfs:domain rdf:resource="#ExamenComplem"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Test Génétique</rdfs:label>
  <synonyme xml:lang="fr">Analyse génétique</synonyme>
  <synonyme xml:lang="fr">Test génomique</synonyme>
  <synonyme xml:lang="fr">Bilan génétique</synonyme>
  <synonyme xml:lang="fr">Recherche de mutations</synonyme>
  <rdfs:comment xml:lang="fr">Valeurs : Mutation CFTR positive | Mutation CFTR | Test de la sueur positif | Chlorure sudoral élevé</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#imagerie">
  <rdfs:domain rdf:resource="#ExamenComplem"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Imagerie Médicale (général)</rdfs:label>
  <synonyme xml:lang="fr">Examen d'imagerie</synonyme>
  <synonyme xml:lang="fr">Exploration radiologique</synonyme>
