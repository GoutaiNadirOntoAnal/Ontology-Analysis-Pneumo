                                          <swrl:argument1 rdf:resource="#d"/>
                                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asthénie</swrl:argument2>
                                        </swrl:DatavaluedPropertyAtom>
