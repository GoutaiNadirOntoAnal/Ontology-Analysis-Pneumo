  <rdfs:label xml:lang="fr">Immunodépression</rdfs:label>
  <synonyme xml:lang="fr">Déficit immunitaire acquis</synonyme>
  <synonyme xml:lang="fr">Immunodéficience</synonyme>
  <synonyme xml:lang="fr">Immunocompromis</synonyme>
  <synonyme xml:lang="fr">Déficit immunitaire</synonyme>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#pathologie">
  <rdfs:domain rdf:resource="#Dossier"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Pathologie suggérée</rdfs:label>
  <rdfs:comment xml:lang="fr">Diagnostic suggéré sauvegardé avec le dossier médical généré par l'analyse NLP.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#symptome">
  <rdfs:domain rdf:resource="#MotifConsultation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Symptôme</rdfs:label>
  <rdfs:comment xml:lang="fr">
      CATALOGUE DES SYMPTÔMES ACCEPTÉS (valeurs normalisées → synonymes) :

      [DYSPNÉE]
      Dyspnée | Essoufflement | Difficultés respiratoires | Souffle court | Difficultés à respirer |
      Gêne respiratoire | Manque d'air | Sensation d'étouffement | Oppression à l'effort |
      Dyspnée d'effort | Dyspnée de repos | Dyspnée progressive | Dyspnée soudaine | Dyspnée aiguë |
      Dyspnée sévère | Polypnée | Tachypnée | Orthopnée | Dyspnée paroxystique nocturne |
      Dyspnée aux gros efforts | Dyspnée aux efforts modérés | Dyspnée aux petits efforts

      [TOUX SÈCHE]
      Toux sèche | Toux non productive | Toux irritative | Toux quinteuse | Toux spasmodique |
      Toux nocturne | Toux sèche persistante | Toux sèche chronique

      [TOUX PRODUCTIVE]
      Toux productive | Toux grasse | Toux avec expectoration | Toux muqueuse | Toux purulente |
      Toux muco-purulente | Toux ramenant des crachats | Expectoration

      [SIFFLEMENT]
      Sifflement | Wheezing | Respiration sifflante | Bronchospasme audible | Stridor bronchique

      [OPPRESSION THORACIQUE]
      Oppression thoracique | Gêne thoracique | Sensation de poids sur la poitrine | Pesanteur thoracique |
      Constriction thoracique | Étreinte thoracique | Sensation d'étau dans la poitrine

      [DOULEUR THORACIQUE]
      Douleur thoracique | Douleur thoracique aiguë | Douleur pleurale | Douleur punctiforme |
      Douleur en coup de poignard | Douleur basithoracique | Point de côté | Pleurodynie | Algie thoracique

      [CRACHAT DE SANG]
      Crachat de sang | Hémoptysie | Expectoration sanglante | Hémoptysie de grande abondance |
      Hémoptysie de faible abondance | Crachats striés de sang | Hémoptysies récidivantes

      [INFECTIONS BRONCHIQUES]
      Infections bronchiques | Exacerbations infectieuses bronchiques | Surinfections bronchiques |
      Bronchites répétées | Infections broncho-pulmonaires récidivantes | Exacerbations

      [EXPECTORATION MATINALE]
      Expectoration matinale | Expectoration au lever | Bronchorrhée matinale | Crachat du matin |
      Bron­chorrhée chronique

      [SUEURS NOCTURNES]
      Sueurs nocturnes | Transpiration nocturne | Sudation nocturne | Sueurs profuses nocturnes

      [FIÈVRE]
      Fièvre | Hyperthermie | Pyrexie | État fébrile | Fièvre élevée | Fébricule |
      Syndrome fébrile | Fièvre persistante | Subfébrile

      [FATIGUE / ASTHÉNIE]
      Asthénie | Fatigue | Fatigabilité | Épuisement | Affaiblissement général | Lassitude |
      Fatigue chronique | Faiblesse générale

      [PERTE DE POIDS]
      Perte de poids | Amaigrissement | Perte pondérale | Amaigrissement involontaire |
      Cachexie | Maigreur progressive

      [RONFLEMENTS / APNÉES]
      Ronflement | Ronchopathie | Ronflement sévère | Ronflements nocturnes
      Somnolence diurne | Hypersomnolence | Somnolence excessive | Somnolence diurne excessive | Endormissement involontaire

      [TACHYCARDIE]
      Tachycardie | Palpitations | Accélération du rythme cardiaque | Tachycardie sinusale

      [AUTRES]
      Cyanose des lèvres | Cyanose périphérique | Cyanose centrale
      Douleur thoracique aiguë | Dyspnée soudaine
      Infections bronchiques répétées | Surinfections respiratoires
    </rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#signe">
  <rdfs:domain rdf:resource="#MotifConsultation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Signe Clinique (objectif)</rdfs:label>
  <rdfs:comment xml:lang="fr">
      CATALOGUE DES SIGNES CLINIQUES OBJECTIFS :

      [SIGNES GÉNÉRAUX]
      Fièvre | Hyperthermie | Pyrexie | État fébrile
      Perte de poids | Amaigrissement | Perte pondérale | Cachexie
      Asthénie | Fatigue | Affaiblissement | Lassitude

      [SIGNES RESPIRATOIRES]
      Tachypnée | Polypnée | Bradypnée | Apnée | Apnées observées
      Cyanose | Cyanose labiale | Cyanose périphérique | Cyanose centrale | Teint bleuté
      Hippocratisme digital | Hypocratisme digital | Doigts en baguette de tambour | Ongles en verre de montre
    </rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#dureeSymptomes">
  <rdfs:domain rdf:resource="#MotifConsultation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Durée des Symptômes</rdfs:label>
  <rdfs:comment xml:lang="fr">Valeurs : ≥3 mois | &lt; 1 semaine | 1-4 semaines | 1-3 mois | &gt; 6 mois | Chronique | Aigu | Subaigu</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#exacerbation">
  <rdfs:domain rdf:resource="#MotifConsultation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Exacerbation</rdfs:label>
  <synonyme xml:lang="fr">Poussée aiguë</synonyme>
  <synonyme xml:lang="fr">Décompensation</synonyme>
  <synonyme xml:lang="fr">Aggravation aiguë</synonyme>
  <synonyme xml:lang="fr">Crise</synonyme>
  <synonyme xml:lang="fr">Episode aigu sur chronique</synonyme>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#examcli">
  <rdfs:domain rdf:resource="#ExamenComplem"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Examen Clinique (auscultation / inspection)</rdfs:label>
  <rdfs:comment xml:lang="fr">
      CATALOGUE DES SIGNES À L'EXAMEN CLINIQUE (avec synonymes) :

      [BRUITS RESPIRATOIRES ANORMAUX]
      Râles sibilants | Sibilants | Wheezing | Sifflements auscultatoires | Bruits sibilants | Bronchospasme auscultoire
      Râles ronflants | Ronchus | Ronchis | Bruits ronflants | Frottement ronflant | Ronflements à l'auscultation
      Râles crépitants | Crépitants | Crépitations | Crépitants fins bibasaux | Crépitants fins | Velcro sound | Bruit de Velcro
      Respiration sifflante | Stridor | Stridor inspiratoire | Stridor expiratoire
      Diminution du murmure vésiculaire | Diminution de murmure vésiculaire | Murmure vésiculaire diminué | MV diminué | Hypoventilation
      Silence auscultatoire | Abolition du MV | Absence du murmure vésiculaire
      Souffle tubaire | Souffle bronchique | Syndrome de condensation

      [SIGNES D'HYPERINFLATION]
      Signe de Hoover | Signe de Campbell | Tirage intercostal | Tirage sous-costal | Tirage sus-sternal
      Expiration à lèvres pincées | Expiration à lèvres pincée | Breathing pursed lips | Frein labial
      Distension thoracique auscultatoire | Thorax en tonneau (à l'examen)

      [SIGNES CARDIOVASCULAIRES / SATURATION]
      Hypoxémie | Désaturation | SpO2 basse | Saturation en oxygène réduite | Hypoxie
      Tachypnée | Polypnée | Fréquence respiratoire élevée
      Tachycardie | Accélération du rythme cardiaque | Pouls rapide

      [SIGNES SPÉCIFIQUES]
      Apnées observées | Apnées nocturnes observées | Pauses respiratoires nocturnes
      Crépitants fins bibasaux | Crépitants bibasaux | Crépitations bibasales
      Hypocratisme digital | Hippocratisme digital | Doigts en baguette de tambour
      Épanchement pleural | Matité à la percussion | Douleur à la palpation thoracique
    </rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#efr">
  <rdfs:domain rdf:resource="#ExamenComplem"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Exploration Fonctionnelle Respiratoire (EFR / Spirométrie)</rdfs:label>
  <synonyme xml:lang="fr">Spirométrie</synonyme>
  <synonyme xml:lang="fr">Épreuves fonctionnelles respiratoires</synonyme>
  <synonyme xml:lang="fr">Bilan fonctionnel respiratoire</synonyme>
  <synonyme xml:lang="fr">Pléthysmographie</synonyme>
  <rdfs:comment xml:lang="fr">
      VALEURS NORMALISÉES :
      TVO réversible sous bronchodilatateur | TVO réversible après bronchodilatateur | Trouble ventilatoire obstructif réversible
      TVO non réversible après bronchodilatateur | TVO non réversible | Obstruction fixe | Trouble ventilatoire obstructif irréversible
      TVO réversible partielle | Réversibilité partielle sous bronchodilatateur
      Trouble ventilatoire restrictif | TVR | Syndrome restrictif | Réduction de la CPT
      Trouble ventilatoire mixte | Syndrome mixte
      Normal | EFR normale | Pas de trouble ventilatoire
    </rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#radio">
  <rdfs:domain rdf:resource="#ExamenComplem"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Radiographie Thoracique</rdfs:label>
  <synonyme xml:lang="fr">Radio du thorax</synonyme>
  <synonyme xml:lang="fr">Radiographie pulmonaire</synonyme>
  <synonyme xml:lang="fr">Rx thorax</synonyme>
  <synonyme xml:lang="fr">Cliché thoracique</synonyme>
  <rdfs:comment xml:lang="fr">
      VALEURS NORMALISÉES :
      Distension thoracique | Hyperinflation pulmonaire | Thorax en tonneau | Aplatissement des coupoles diaphragmatiques
      Raréfaction de la vascularisation | Hyperclarté pulmonaire | Raréfaction vasculaire | Emphysème radiologique
      Syndrome interstitiel | Opacités interstitielles | Réseau interstitiel | Épaississement des septa
      Infiltrat alvéolaire localisé | Opacité alvéolaire localisée | Foyer de condensation localisé | Syndrome alvéolaire focal
      Infiltrats pulmonaires diffus | Opacités bilatérales diffuses | Syndrome alvéolaire diffus
      Épanchement pleural | Épanchement plèvre | Comblement du cul-de-sac costodiaphragmatique
      Présence d'air pleural | Décollement pleural | Pneumothorax radiologique | Clarté pleurale | Hyperclarté apicale
      Opacité homogène | Opacité en verre dépoli | Plage de verre dépoli
      Cardiomégalie | Élargissement de la silhouette cardiaque | Rapport cardiothoracique augmenté
      Normale | Radio thoracique normale | Pas d'anomalie radiologique
    </rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#tdm">
  <rdfs:domain rdf:resource="#ExamenComplem"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Tomodensitométrie Thoracique (TDM / Scanner)</rdfs:label>
  <synonyme xml:lang="fr">Scanner thoracique</synonyme>
  <synonyme xml:lang="fr">Tomodensitométrie</synonyme>
  <synonyme xml:lang="fr">TDM-HR (haute résolution)</synonyme>
  <synonyme xml:lang="fr">HRCT</synonyme>
  <synonyme xml:lang="fr">Tomodensitométrie haute résolution</synonyme>
  <rdfs:comment xml:lang="fr">
      VALEURS NORMALISÉES :
      Opacités en verre dépoli bilatérales | Plages de verre dépoli bilatérales | Ground-glass opacities bilatérales
      Dilatation de bronches cylindriques | Bronchectasies cylindriques | DDB cylindriques
      Dilatation de bronches kystiques | Bronchectasies kystiques | DDB kystiques | Bronchectasies sacculaires
      Dilatation de bronches variqueuses | Bronchectasies variqueuses | DDB variqueuses
      Reticulations diffuses et épaississement septal | Réticulations | Épaississement des septa interlobulaires | Pattern UIP
      Rayon de miel | Honeycombing | Kystes en rayon de miel
      Emphysème centro-lobulaire | Emphysème pan-lobulaire | Emphysème paraseptal | Bulles d'emphysème
      Nodule pulmonaire | Nodule solide | Nodule en verre dépoli | Nodule mixte | Masse pulmonaire
      Adénopathies médiastinales | Adénomégalies | Ganglions médiastinaux élargis
    </rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#angioscanner">
  <rdfs:domain rdf:resource="#ExamenComplem"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Angio-Scanner Pulmonaire</rdfs:label>
  <synonyme xml:lang="fr">Angioscanner thoracique</synonyme>
  <synonyme xml:lang="fr">Angio-TDM pulmonaire</synonyme>
  <synonyme xml:lang="fr">Scanner avec injection de produit de contraste</synonyme>
  <synonyme xml:lang="fr">Angiographie TDM pulmonaire</synonyme>
  <rdfs:comment xml:lang="fr">
      VALEURS NORMALISÉES :
      Embolie artère pulmonaire | Embolie pulmonaire | Défect endoluminal | Lacune endoluminale | Thrombus artère pulmonaire
      Thrombose artérielle pulmonaire | EP centrale | EP périphérique | EP lobaire | EP segmentaire
      Pas d'embolie pulmonaire | Angio-scanner négatif | Absence de thrombus
    </rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#polygraphie">
  <rdfs:domain rdf:resource="#ExamenComplem"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Polygraphie / Polysomnographie (test du sommeil)</rdfs:label>
  <synonyme xml:lang="fr">Enregistrement du sommeil</synonyme>
  <synonyme xml:lang="fr">Test du sommeil</synonyme>
  <synonyme xml:lang="fr">Polysomnographie</synonyme>
  <synonyme xml:lang="fr">PSG</synonyme>
  <synonyme xml:lang="fr">Polygraphie ventilatoire nocturne</synonyme>
  <synonyme xml:lang="fr">SAOS test</synonyme>
  <rdfs:comment xml:lang="fr">
      VALEURS NORMALISÉES :
      Index d'apnées-hypopnées &gt; 15 | IAH &gt; 15 | SAOS modéré à sévère
      Index d'apnées-hypopnées &gt; 30 | IAH &gt; 30 | SAOS sévère
      Index d'apnées-hypopnées 5-15 | IAH 5-15 | SAOS léger
      Index d'apnées-hypopnées &lt; 5 | IAH &lt; 5 | Polygraphie normale
    </rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#biologie">
  <rdfs:domain rdf:resource="#ExamenComplem"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label xml:lang="fr">Examens Biologiques</rdfs:label>
  <synonyme xml:lang="fr">Bilan biologique</synonyme>
  <synonyme xml:lang="fr">Analyses sanguines</synonyme>
  <synonyme xml:lang="fr">Biologie sanguine</synonyme>
  <synonyme xml:lang="fr">Examens de laboratoire</synonyme>
  <rdfs:comment xml:lang="fr">
      VALEURS NORMALISÉES :
      PCR virale positive | PCR positive | RT-PCR positive | Test viral positif
      NFS | Numération formule sanguine | Hémogramme
      CRP élevée | Syndrome inflammatoire biologique | VS accélérée | Hyperleucocytose
      D-dimères élevés | D-dimères positifs | D-dimères augmentés
      Gaz du sang | Gazométrie artérielle | Hypoxémie confirmée | Hypercapnie
      BNP élevé | NT-proBNP élevé | Peptide natriurétique élevé
      Sérologie | ECBC (examen cytobactériologique des crachats) | Hémocultures positives
    </rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#testLab">
  <rdfs:domain rdf:resource="#ExamenComplem"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
