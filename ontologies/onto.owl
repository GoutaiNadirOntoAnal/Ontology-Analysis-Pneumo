                                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TVO réversible sous bronchodilatateur</swrl:argument2>
                                            </swrl:DatavaluedPropertyAtom>
                                          </rdf:first>
