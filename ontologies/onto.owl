                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Opacités en verre dépoli</swrl:argument2>
                                    </swrl:DatavaluedPropertyAtom>
                                  </rdf:first>
                                  <rdf:rest>
                                    <swrl:AtomList>
                                      <rdf:first>
                                        <swrl:DatavaluedPropertyAtom>
                                          <swrl:propertyPredicate rdf:resource="#testLab"/>
                                          <swrl:argument1 rdf:resource="#d"/>
                                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PCR positive virus respiratoire</swrl:argument2>
                                        </swrl:DatavaluedPropertyAtom>
