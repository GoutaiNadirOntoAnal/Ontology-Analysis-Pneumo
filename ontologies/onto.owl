  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BPCO2</rdfs:label>
  <rdfs:comment xml:lang="fr">BPCO : tabac + tableau obstructif complet + TVO non réversible (sans critère d'âge)</rdfs:comment>
</swrl:Imp>

<!-- Règle : Tuberculose -->
