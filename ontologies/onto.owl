<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/domo/ontologies/2023/4/D-ONTO"
         xmlns="http://www.semanticweb.org/domo/ontologies/2023/4/D-ONTO#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#"
         xmlns:swrl2="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
         xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">

<owl:Ontology rdf:about="http://www.semanticweb.org/domo/ontologies/2023/4/D-ONTO">
  <rdfs:label xml:lang="fr">Ontologie de Pneumologie (D-ONTO)</rdfs:label>
  <rdfs:comment xml:lang="fr">Ontologie médicale pour la gestion des dossiers patients en pneumologie, incluant la classification des pathologies pulmonaires et les règles de diagnostic basées sur les symptômes cliniques.</rdfs:comment>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.0</owl:versionInfo>
</owl:Ontology>

<!-- ===================================================== -->
<!-- PROPRIÉTÉS D'OBJET                                    -->
<!-- ===================================================== -->

<owl:ObjectProperty rdf:about="#aDossier">
  <owl:inverseOf rdf:resource="#dossierDe"/>
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Dossier"/>
  <rdfs:label xml:lang="fr">a Dossier</rdfs:label>
  <abbreviationOf xml:lang="fr">Le patient a un Dossier</abbreviationOf>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dossierDe">
  <rdfs:domain rdf:resource="#Dossier"/>
  <rdfs:range rdf:resource="#Patient"/>
  <rdfs:label xml:lang="fr">dossier De</rdfs:label>
  <abbreviationOf xml:lang="fr">Dossier appartenant au Patient</abbreviationOf>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aMedecin">
  <owl:inverseOf rdf:resource="#aPatient"/>
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Medecin"/>
  <rdfs:label xml:lang="fr">a Médecin</rdfs:label>
  <abbreviationOf xml:lang="fr">Le patient a un Médecin</abbreviationOf>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aPatient">
  <rdfs:domain rdf:resource="#Medecin"/>
  <rdfs:range rdf:resource="#Patient"/>
  <rdfs:label xml:lang="fr">a Patient</rdfs:label>
  <abbreviationOf xml:lang="fr">Le médecin a un Patient</abbreviationOf>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aPathologie">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Pathologie"/>
  <rdfs:label xml:lang="fr">a Pathologie</rdfs:label>
  <abbreviationOf xml:lang="fr">Le patient a une Pathologie</abbreviationOf>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#seRendA">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Hopital"/>
  <rdfs:label xml:lang="fr">se Rend À</rdfs:label>
  <abbreviationOf xml:lang="fr">Le patient se rend à l'Hôpital</abbreviationOf>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#travailleDans">
  <rdfs:domain rdf:resource="#Medecin"/>
  <rdfs:range rdf:resource="#Hopital"/>
  <rdfs:label xml:lang="fr">travaille Dans</rdfs:label>
  <abbreviationOf xml:lang="fr">Le médecin travaille dans un Hôpital</abbreviationOf>
</owl:ObjectProperty>

