<!-- Règle 150 : Pneumothorax Spontané Primaire -->
<swrl:Imp rdf:about="#regle_150_PneumothoraxSpontanePrimaire">
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:ClassAtom>
