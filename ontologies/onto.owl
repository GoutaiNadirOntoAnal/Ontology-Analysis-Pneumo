  <rdfs:comment xml:lang="fr">Tuberculose : hémoptysie + sueurs nocturnes + AEG (fièvre, amaigrissement, asthénie)</rdfs:comment>
</swrl:Imp>

<!-- Règle : Fibrose pulmonaire (fibpul1) -->
<swrl:Imp>
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Patient"/>
          <swrl:argument1 rdf:resource="#p"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#aDossier"/>
              <swrl:argument1 rdf:resource="#p"/>
              <swrl:argument2 rdf:resource="#d"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#symptome"/>
                  <swrl:argument1 rdf:resource="#d"/>
                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Toux sèche</swrl:argument2>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <swrl:AtomList>
                  <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#symptome"/>
                      <swrl:argument1 rdf:resource="#d"/>
                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dyspnée de repos</swrl:argument2>
                    </swrl:DatavaluedPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <swrl:AtomList>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#examcli"/>
                          <swrl:argument1 rdf:resource="#d"/>
                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Râles crépitants</swrl:argument2>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <swrl:AtomList>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="#examcli"/>
                              <swrl:argument1 rdf:resource="#d"/>
                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hypocratisme digital</swrl:argument2>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <swrl:AtomList>
                              <rdf:first>
                                <swrl:DatavaluedPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="#radio"/>
                                  <swrl:argument1 rdf:resource="#d"/>
                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Syndrome interstitiel</swrl:argument2>
                                </swrl:DatavaluedPropertyAtom>
                              </rdf:first>
                              <rdf:rest>
                                <swrl:AtomList>
                                  <rdf:first>
                                    <swrl:DatavaluedPropertyAtom>
                                      <swrl:propertyPredicate rdf:resource="#efr"/>
                                      <swrl:argument1 rdf:resource="#d"/>
                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trouble ventilatoire restrictif</swrl:argument2>
                                    </swrl:DatavaluedPropertyAtom>
                                  </rdf:first>
                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                </swrl:AtomList>
                              </rdf:rest>
                            </swrl:AtomList>
                          </rdf:rest>
                        </swrl:AtomList>
                      </rdf:rest>
                    </swrl:AtomList>
                  </rdf:rest>
                </swrl:AtomList>
              </rdf:rest>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
      </rdf:rest>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#aPathologie"/>
          <swrl:argument1 rdf:resource="#p"/>
          <swrl:argument2 rdf:resource="#fibpul"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:head>
  <swrl2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl2:isRuleEnabled>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fibpul1</rdfs:label>
  <rdfs:comment xml:lang="fr">Fibrose pulmonaire : toux sèche + dyspnée de repos + crépitants + hippocratisme + syndrome interstitiel + TVR</rdfs:comment>
</swrl:Imp>

<!-- Règle : FPI -->
<swrl:Imp>
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Patient"/>
          <swrl:argument1 rdf:resource="#p"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#aDossier"/>
              <swrl:argument1 rdf:resource="#p"/>
              <swrl:argument2 rdf:resource="#d"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#symptome"/>
                  <swrl:argument1 rdf:resource="#d"/>
                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dyspnée progressive</swrl:argument2>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <swrl:AtomList>
                  <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#symptome"/>
                      <swrl:argument1 rdf:resource="#d"/>
                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Toux sèche</swrl:argument2>
                    </swrl:DatavaluedPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <swrl:AtomList>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#examcli"/>
                          <swrl:argument1 rdf:resource="#d"/>
                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crépitants fins bibasaux</swrl:argument2>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <swrl:AtomList>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="#tdm"/>
                              <swrl:argument1 rdf:resource="#d"/>
                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reticulations diffuses et épaississement septal</swrl:argument2>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </swrl:AtomList>
                      </rdf:rest>
                    </swrl:AtomList>
                  </rdf:rest>
                </swrl:AtomList>
              </rdf:rest>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
      </rdf:rest>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#aPathologie"/>
          <swrl:argument1 rdf:resource="#p"/>
          <swrl:argument2 rdf:resource="#FibrosePulmonaireIdiopathiqueInd"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:head>
  <swrl2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl2:isRuleEnabled>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fibrose_Pulmonaire_Idiopathique</rdfs:label>
  <rdfs:comment xml:lang="fr">FPI : dyspnée progressive + toux sèche + crépitants bibasaux + réticulations TDM</rdfs:comment>
</swrl:Imp>

<!-- Règles : DDB -->
<swrl:Imp>
  <swrl:body>
    <swrl:AtomList>
