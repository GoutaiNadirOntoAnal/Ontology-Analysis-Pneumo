<!-- Règle 171 : Cancer Bronchique Non à Petites Cellules (CBNPC) -->
<swrl:Imp rdf:about="#regle_171_CBNPC">
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Patient"/>
          <swrl:argument1 rdf:resource="urn:swrl#p"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#age"/>
              <swrl:argument1 rdf:resource="urn:swrl#p"/>
              <swrl:argument2 rdf:resource="urn:swrl#a"/>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:BuiltinAtom>
                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                  <swrl:arguments>
                    <rdf:List>
                      <rdf:first rdf:resource="urn:swrl#a"/>
                      <rdf:rest>
                        <rdf:List>
                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:List>
                      </rdf:rest>
                    </rdf:List>
                  </swrl:arguments>
                </swrl:BuiltinAtom>
              </rdf:first>
              <rdf:rest>
                <swrl:AtomList>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#aDossier"/>
                      <swrl:argument1 rdf:resource="urn:swrl#p"/>
                      <swrl:argument2 rdf:resource="urn:swrl#d"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <swrl:AtomList>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#habitVie"/>
                          <swrl:argument1 rdf:resource="urn:swrl#d"/>
                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tabac actif</swrl:argument2>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <swrl:AtomList>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="#symptome"/>
                              <swrl:argument1 rdf:resource="urn:swrl#d"/>
                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Toux chronique</swrl:argument2>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <swrl:AtomList>
                              <rdf:first>
                                <swrl:DatavaluedPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="#symptome"/>
                                  <swrl:argument1 rdf:resource="urn:swrl#d"/>
                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hémoptysie</swrl:argument2>
                                </swrl:DatavaluedPropertyAtom>
                              </rdf:first>
                              <rdf:rest>
                                <swrl:AtomList>
                                  <rdf:first>
                                    <swrl:DatavaluedPropertyAtom>
                                      <swrl:propertyPredicate rdf:resource="#symptome"/>
                                      <swrl:argument1 rdf:resource="urn:swrl#d"/>
                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dyspnée</swrl:argument2>
                                    </swrl:DatavaluedPropertyAtom>
                                  </rdf:first>
                                  <rdf:rest>
                                    <swrl:AtomList>
                                      <rdf:first>
                                        <swrl:DatavaluedPropertyAtom>
                                          <swrl:propertyPredicate rdf:resource="#radio"/>
                                          <swrl:argument1 rdf:resource="urn:swrl#d"/>
                                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Opacité pulmonaire</swrl:argument2>
                                        </swrl:DatavaluedPropertyAtom>
                                      </rdf:first>
                                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </swrl:AtomList>
                                  </rdf:rest>
                                </swrl:AtomList>
                              </rdf:rest>
                            </swrl:AtomList>
                          </rdf:rest>
                        </swrl:AtomList>
                      </rdf:rest>
                    </swrl:AtomList>
                  </rdf:rest>
                </swrl:AtomList>
              </rdf:rest>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
      </rdf:rest>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#aPathologie"/>
          <swrl:argument1 rdf:resource="urn:swrl#p"/>
          <swrl:argument2 rdf:resource="#CBNPC"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:head>
  <swrl2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl2:isRuleEnabled>
  <rdfs:label xml:lang="fr">Règle 171 : Cancer Bronchique Non à Petites Cellules (CBNPC)</rdfs:label>
</swrl:Imp>

