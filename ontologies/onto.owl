<!-- Règle : BPCO1 (avec âge ≥ 40) -->
<swrl:Imp>
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Patient"/>
          <swrl:argument1 rdf:resource="#p"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <swrl:AtomList>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#age"/>
              <swrl:argument1 rdf:resource="#p"/>
              <swrl:argument2 rdf:resource="#a"/>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:BuiltinAtom>
                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                  <swrl:arguments>
                    <rdf:List>
                      <rdf:first rdf:resource="#a"/>
                      <rdf:rest>
                        <rdf:List>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40</rdf:first>
                        </rdf:List>
                      </rdf:rest>
                    </rdf:List>
                  </swrl:arguments>
                </swrl:BuiltinAtom>
              </rdf:first>
              <rdf:rest>
                <swrl:AtomList>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#aDossier"/>
                      <swrl:argument1 rdf:resource="#p"/>
                      <swrl:argument2 rdf:resource="#d"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <swrl:AtomList>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#habitVie"/>
                          <swrl:argument1 rdf:resource="#d"/>
                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tabac actif</swrl:argument2>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <swrl:AtomList>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="#symptome"/>
                              <swrl:argument1 rdf:resource="#d"/>
                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dyspnée</swrl:argument2>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <swrl:AtomList>
                              <rdf:first>
                                <swrl:DatavaluedPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="#symptome"/>
                                  <swrl:argument1 rdf:resource="#d"/>
                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Toux productive</swrl:argument2>
                                </swrl:DatavaluedPropertyAtom>
                              </rdf:first>
                              <rdf:rest>
                                <swrl:AtomList>
                                  <rdf:first>
                                    <swrl:DatavaluedPropertyAtom>
                                      <swrl:propertyPredicate rdf:resource="#examcli"/>
                                      <swrl:argument1 rdf:resource="#d"/>
                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Râles ronflants</swrl:argument2>
                                    </swrl:DatavaluedPropertyAtom>
                                  </rdf:first>
                                  <rdf:rest>
                                    <swrl:AtomList>
                                      <rdf:first>
                                        <swrl:DatavaluedPropertyAtom>
                                          <swrl:propertyPredicate rdf:resource="#examcli"/>
                                          <swrl:argument1 rdf:resource="#d"/>
                                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cyanose</swrl:argument2>
                                        </swrl:DatavaluedPropertyAtom>
                                      </rdf:first>
                                      <rdf:rest>
                                        <swrl:AtomList>
                                          <rdf:first>
                                            <swrl:DatavaluedPropertyAtom>
                                              <swrl:propertyPredicate rdf:resource="#examcli"/>
                                              <swrl:argument1 rdf:resource="#d"/>
                                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Signe de Hoover</swrl:argument2>
                                            </swrl:DatavaluedPropertyAtom>
                                          </rdf:first>
                                          <rdf:rest>
                                            <swrl:AtomList>
                                              <rdf:first>
                                                <swrl:DatavaluedPropertyAtom>
                                                  <swrl:propertyPredicate rdf:resource="#examcli"/>
                                                  <swrl:argument1 rdf:resource="#d"/>
                                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diminution de murmure vésiculaire</swrl:argument2>
                                                </swrl:DatavaluedPropertyAtom>
                                              </rdf:first>
                                              <rdf:rest>
                                                <swrl:AtomList>
                                                  <rdf:first>
                                                    <swrl:DatavaluedPropertyAtom>
                                                      <swrl:propertyPredicate rdf:resource="#examcli"/>
                                                      <swrl:argument1 rdf:resource="#d"/>
                                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expiration à lèvres pincée</swrl:argument2>
                                                    </swrl:DatavaluedPropertyAtom>
                                                  </rdf:first>
                                                  <rdf:rest>
                                                    <swrl:AtomList>
                                                      <rdf:first>
                                                        <swrl:DatavaluedPropertyAtom>
                                                          <swrl:propertyPredicate rdf:resource="#efr"/>
                                                          <swrl:argument1 rdf:resource="#d"/>
                                                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TVO non réversible après bronchodilatateur</swrl:argument2>
                                                        </swrl:DatavaluedPropertyAtom>
                                                      </rdf:first>
                                                      <rdf:rest>
                                                        <swrl:AtomList>
                                                          <rdf:first>
                                                            <swrl:DatavaluedPropertyAtom>
                                                              <swrl:propertyPredicate rdf:resource="#radio"/>
                                                              <swrl:argument1 rdf:resource="#d"/>
                                                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raréfaction de la vascularisation</swrl:argument2>
                                                            </swrl:DatavaluedPropertyAtom>
                                                          </rdf:first>
                                                          <rdf:rest>
                                                            <swrl:AtomList>
                                                              <rdf:first>
                                                                <swrl:DatavaluedPropertyAtom>
                                                                  <swrl:propertyPredicate rdf:resource="#radio"/>
                                                                  <swrl:argument1 rdf:resource="#d"/>
                                                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distension thoracique</swrl:argument2>
                                                                </swrl:DatavaluedPropertyAtom>
                                                              </rdf:first>
                                                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </swrl:AtomList>
                                                          </rdf:rest>
                                                        </swrl:AtomList>
                                                      </rdf:rest>
                                                    </swrl:AtomList>
                                                  </rdf:rest>
                                                </swrl:AtomList>
                                              </rdf:rest>
                                            </swrl:AtomList>
                                          </rdf:rest>
                                        </swrl:AtomList>
                                      </rdf:rest>
                                    </swrl:AtomList>
                                  </rdf:rest>
                                </swrl:AtomList>
                              </rdf:rest>
                            </swrl:AtomList>
                          </rdf:rest>
                        </swrl:AtomList>
                      </rdf:rest>
                    </swrl:AtomList>
                  </rdf:rest>
                </swrl:AtomList>
              </rdf:rest>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
      </rdf:rest>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#aPathologie"/>
          <swrl:argument1 rdf:resource="#p"/>
          <swrl:argument2 rdf:resource="#BPCO"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:head>
  <swrl2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl2:isRuleEnabled>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BPCO1</rdfs:label>
  <rdfs:comment xml:lang="fr">BPCO : âge ≥ 40 + tabac + tableau clinique obstructif complet + TVO non réversible</rdfs:comment>
</swrl:Imp>

<!-- Règle : BPCO2 (sans critère d'âge) -->
<swrl:Imp>
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Patient"/>
          <swrl:argument1 rdf:resource="#p"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#aDossier"/>
              <swrl:argument1 rdf:resource="#p"/>
              <swrl:argument2 rdf:resource="#d"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#habitVie"/>
                  <swrl:argument1 rdf:resource="#d"/>
                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tabac actif</swrl:argument2>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <swrl:AtomList>
                  <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#symptome"/>
                      <swrl:argument1 rdf:resource="#d"/>
                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dyspnée</swrl:argument2>
                    </swrl:DatavaluedPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <swrl:AtomList>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#symptome"/>
                          <swrl:argument1 rdf:resource="#d"/>
                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Toux productive</swrl:argument2>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <swrl:AtomList>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="#examcli"/>
                              <swrl:argument1 rdf:resource="#d"/>
                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Râles ronflants</swrl:argument2>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <swrl:AtomList>
                              <rdf:first>
                                <swrl:DatavaluedPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="#examcli"/>
                                  <swrl:argument1 rdf:resource="#d"/>
                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cyanose</swrl:argument2>
                                </swrl:DatavaluedPropertyAtom>
                              </rdf:first>
                              <rdf:rest>
                                <swrl:AtomList>
                                  <rdf:first>
                                    <swrl:DatavaluedPropertyAtom>
                                      <swrl:propertyPredicate rdf:resource="#examcli"/>
                                      <swrl:argument1 rdf:resource="#d"/>
                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Signe de Hoover</swrl:argument2>
                                    </swrl:DatavaluedPropertyAtom>
                                  </rdf:first>
                                  <rdf:rest>
                                    <swrl:AtomList>
                                      <rdf:first>
                                        <swrl:DatavaluedPropertyAtom>
                                          <swrl:propertyPredicate rdf:resource="#examcli"/>
                                          <swrl:argument1 rdf:resource="#d"/>
                                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diminution de murmure vésiculaire</swrl:argument2>
                                        </swrl:DatavaluedPropertyAtom>
                                      </rdf:first>
                                      <rdf:rest>
                                        <swrl:AtomList>
                                          <rdf:first>
                                            <swrl:DatavaluedPropertyAtom>
                                              <swrl:propertyPredicate rdf:resource="#examcli"/>
                                              <swrl:argument1 rdf:resource="#d"/>
                                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expiration à lèvres pincée</swrl:argument2>
                                            </swrl:DatavaluedPropertyAtom>
                                          </rdf:first>
                                          <rdf:rest>
                                            <swrl:AtomList>
                                              <rdf:first>
                                                <swrl:DatavaluedPropertyAtom>
                                                  <swrl:propertyPredicate rdf:resource="#efr"/>
                                                  <swrl:argument1 rdf:resource="#d"/>
                                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TVO non réversible après bronchodilatateur</swrl:argument2>
                                                </swrl:DatavaluedPropertyAtom>
                                              </rdf:first>
                                              <rdf:rest>
                                                <swrl:AtomList>
                                                  <rdf:first>
                                                    <swrl:DatavaluedPropertyAtom>
                                                      <swrl:propertyPredicate rdf:resource="#radio"/>
                                                      <swrl:argument1 rdf:resource="#d"/>
                                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raréfaction de la vascularisation</swrl:argument2>
                                                    </swrl:DatavaluedPropertyAtom>
                                                  </rdf:first>
                                                  <rdf:rest>
                                                    <swrl:AtomList>
                                                      <rdf:first>
                                                        <swrl:DatavaluedPropertyAtom>
                                                          <swrl:propertyPredicate rdf:resource="#radio"/>
                                                          <swrl:argument1 rdf:resource="#d"/>
                                                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distension thoracique</swrl:argument2>
                                                        </swrl:DatavaluedPropertyAtom>
                                                      </rdf:first>
                                                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </swrl:AtomList>
                                                  </rdf:rest>
                                                </swrl:AtomList>
                                              </rdf:rest>
                                            </swrl:AtomList>
                                          </rdf:rest>
                                        </swrl:AtomList>
                                      </rdf:rest>
                                    </swrl:AtomList>
                                  </rdf:rest>
                                </swrl:AtomList>
                              </rdf:rest>
                            </swrl:AtomList>
                          </rdf:rest>
                        </swrl:AtomList>
                      </rdf:rest>
                    </swrl:AtomList>
                  </rdf:rest>
                </swrl:AtomList>
              </rdf:rest>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
      </rdf:rest>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#aPathologie"/>
          <swrl:argument1 rdf:resource="#p"/>
          <swrl:argument2 rdf:resource="#BPCO"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:head>
