                                        </swrl:AtomList>
                                      </rdf:rest>
                                    </swrl:AtomList>
                                  </rdf:rest>
                                </swrl:AtomList>
                              </rdf:rest>
                            </swrl:AtomList>
                          </rdf:rest>
                        </swrl:AtomList>
                      </rdf:rest>
                    </swrl:AtomList>
                  </rdf:rest>
                </swrl:AtomList>
              </rdf:rest>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
      </rdf:rest>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#aPathologie"/>
          <swrl:argument1 rdf:resource="#p"/>
