<!-- ===================================================== -->
<!-- SWRL : Variables                                      -->
<!-- ===================================================== -->

<swrl:Variable rdf:about="urn:swrl#p"/>
<swrl:Variable rdf:about="urn:swrl#d"/>
<swrl:Variable rdf:about="#p"/>
<swrl:Variable rdf:about="#a"/>
<swrl:Variable rdf:about="#d"/>

<!-- ===================================================== -->
<!-- SWRL : Règles principales                             -->
<!-- ===================================================== -->

<!-- Règle : Asthme (asthme1) -->
<swrl:Imp>
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Patient"/>
          <swrl:argument1 rdf:resource="#p"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <swrl:AtomList>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#aDossier"/>
              <swrl:argument1 rdf:resource="#p"/>
              <swrl:argument2 rdf:resource="#d"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <swrl:AtomList>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#symptome"/>
                  <swrl:argument1 rdf:resource="#d"/>
                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dyspnée</swrl:argument2>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <swrl:AtomList>
                  <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#symptome"/>
                      <swrl:argument1 rdf:resource="#d"/>
                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sifflement</swrl:argument2>
                    </swrl:DatavaluedPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <swrl:AtomList>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#symptome"/>
                          <swrl:argument1 rdf:resource="#d"/>
                          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oppression thoracique</swrl:argument2>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <swrl:AtomList>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="#symptome"/>
                              <swrl:argument1 rdf:resource="#d"/>
                              <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Toux sèche</swrl:argument2>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <swrl:AtomList>
                              <rdf:first>
                                <swrl:DatavaluedPropertyAtom>
                                  <swrl:propertyPredicate rdf:resource="#examcli"/>
                                  <swrl:argument1 rdf:resource="#d"/>
                                  <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Râles sibilants</swrl:argument2>
                                </swrl:DatavaluedPropertyAtom>
                              </rdf:first>
                              <rdf:rest>
                                <swrl:AtomList>
                                  <rdf:first>
                                    <swrl:DatavaluedPropertyAtom>
                                      <swrl:propertyPredicate rdf:resource="#efr"/>
                                      <swrl:argument1 rdf:resource="#d"/>
                                      <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TVO réversible sous bronchodilatateur</swrl:argument2>
                                    </swrl:DatavaluedPropertyAtom>
                                  </rdf:first>
                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                </swrl:AtomList>
                              </rdf:rest>
                            </swrl:AtomList>
                          </rdf:rest>
                        </swrl:AtomList>
                      </rdf:rest>
                    </swrl:AtomList>
                  </rdf:rest>
                </swrl:AtomList>
              </rdf:rest>
            </swrl:AtomList>
          </rdf:rest>
        </swrl:AtomList>
      </rdf:rest>
    </swrl:AtomList>
  </swrl:body>
  <swrl:head>
    <swrl:AtomList>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#aPathologie"/>
          <swrl:argument1 rdf:resource="#p"/>
          <swrl:argument2 rdf:resource="#Asthme"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </swrl:AtomList>
  </swrl:head>
  <swrl2:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrl2:isRuleEnabled>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asthme1</rdfs:label>
  <rdfs:comment xml:lang="fr">Asthme : Dyspnée + Sifflement + Oppression thoracique + Toux sèche + Râles sibilants + TVO réversible</rdfs:comment>
</swrl:Imp>

