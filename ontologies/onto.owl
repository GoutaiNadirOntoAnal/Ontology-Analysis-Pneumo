  <rdfs:comment xml:lang="fr">Pneumonie bactérienne : fièvre + toux productive + douleur + dyspnée + crépitants + tachypnée + infiltrat localisé</rdfs:comment>
</swrl:Imp>

<!-- Règle : Pneumonie virale -->
<swrl:Imp>
  <swrl:body>
    <swrl:AtomList>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Patient"/>
